{
  "name": "bedrock-file-grouper",
  "displayName": "Bedrock Add-On File Grouper",
  "description": "An extension that adds a new view within the explorer which groups Minecraft Bedrock Add-On Files by identifier.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "publisher": "hatchibombotar",
  "categories": [
    "Other",
    "Visualization"
  ],
  "repository": {
    "url": "https://github.com/Hatchibombotar/bedrock-file-grouper"
  },
  "activationEvents": [ ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "domainCollator",
          "name": "Grouped Add-On Files"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
