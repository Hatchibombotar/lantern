{
  "name": "bedrock-file-grouper",
  "displayName": "Bedrock Add-On File Grouper",
  "description": "An extension that adds a new view within the explorer which groups Minecraft Bedrock Add-On Files by identifier.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "publisher": "hatchibombotar",
  "categories": [
    "Other",
    "Visualization"
  ],
  "repository": {
    "url": "https://github.com/Hatchibombotar/bedrock-file-grouper"
  },
  "activationEvents": [ ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "domainCollator",
          "name": "Grouped Add-On Files"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.createEntity",
        "title": "Create Entity"
      },
      {
        "command": "extension.createItem",
        "title": "Create Item"
      },


      {
        "command": "extension.entityCopyIdentifier",
        "title": "Copy Entity Identifier"
      },

      {
        "command": "extension.entityCreateBPEntity",
        "title": "Create BP Entity"
      },
      {
        "command": "extension.entityCreateBPAnimation",
        "title": "Create BP Animation"
      },
      {
        "command": "extension.entityCreateBPAnimationController",
        "title": "Create BP Animation Controller"
      },

      {
        "command": "extension.entityCreateRPEntity",
        "title": "Create RP Entity"
      },
      {
        "command": "extension.entityCreateRPAnimation",
        "title": "Create RP Animation"
      },
      {
        "command": "extension.entityCreateRPAnimationController",
        "title": "Create RP Animation Controller"
      },
      {
        "command": "extension.entityCreateRPRenderController",
        "title": "Create RP Render Controller"
      },

    
      {
        "command": "extension.itemCopyIdentifier",
        "title": "Copy Item Identifier"
      },

      {
        "command": "extension.itemCreateBPItem",
        "title": "Create BP Item"
      },

      {
        "command": "extension.itemAttachableCreateRPEntity",
        "title": "Create Attachable"
      },
      {
        "command": "extension.itemAttachableCreateRPAnimation",
        "title": "Create Attachable Animation"
      },
      {
        "command": "extension.itemAttachableCreateRPAnimationController",
        "title": "Create Attachable Animation Controller"
      },
      {
        "command": "extension.itemAttachableCreateRPRenderController",
        "title": "Create Attachable Render Controller"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "extension.createEntity",
          "when": "view == domainCollator && viewItem == folder_entities",
          "group": "createEntity"
        },
        {
          "command": "extension.createItem",
          "when": "view == domainCollator && viewItem == folder_items",
          "group": "createItem"
        },


        {
          "command": "extension.entityCopyIdentifier",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "aboutEntity"
        },

        {
          "command": "extension.entityCreateBPEntity",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileBP"
        },
        {
          "command": "extension.entityCreateBPAnimation",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileBP"
        },
        {
          "command": "extension.entityCreateBPAnimationController",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileBP"
        },

        {
          "command": "extension.entityCreateRPEntity",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileRP"
        },
        {
          "command": "extension.entityCreateRPAnimation",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileRP"
        },
        {
          "command": "extension.entityCreateRPAnimationController",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileRP"
        },
        {
          "command": "extension.entityCreateRPRenderController",
          "when": "view == domainCollator && viewItem == node_entities",
          "group": "createEntityFileRP"
        },



        {
          "command": "extension.itemCopyIdentifier",
          "when": "view == domainCollator && viewItem == node_items",
          "group": "aboutItem"
        },
        {
          "command": "extension.itemCreateBPItem",
          "when": "view == domainCollator && viewItem == node_items",
          "group": "createItemFileBP"
        },


        {
          "command": "extension.itemAttachableCreateRPEntity",
          "when": "view == domainCollator && viewItem == node_items",
          "group": "createItemFileRP"
        },
        {
          "command": "extension.itemAttachableCreateRPAnimation",
          "when": "view == domainCollator && viewItem == node_items",
          "group": "createItemFileRP"
        },
        {
          "command": "extension.itemAttachableCreateRPAnimationController",
          "when": "view == domainCollator && viewItem == node_items",
          "group": "createItemFileRP"
        },
        {
          "command": "extension.itemAttachableCreateRPRenderController",
          "when": "view == domainCollator && viewItem == node_items",
          "group": "createItemFileRP"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
